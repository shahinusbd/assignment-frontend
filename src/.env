# Server Base URL (API Endpoint)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/auth/

# Application Configuration
NEXT_PUBLIC_APP_NAME=MyNextApp
NEXT_PUBLIC_APP_ENV=development   # Options: development, production
NEXT_PUBLIC_APP_VERSION=1.0.0

# Authentication Settings
NEXT_PUBLIC_AUTH_PROVIDER=jwt     # Options: jwt, oauth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NEXT_PUBLIC_FACEBOOK_APP_ID=your-facebook-app-id

# Other Configurations
NEXT_PUBLIC_FEATURE_FLAG_EXAMPLE=true # Example feature flag
NEXT_PUBLIC_ANALYTICS_ID=your-analytics-id

# Optional Backend Communication Configurations
NEXT_PUBLIC_GRAPHQL_ENDPOINT=http://localhost:5000/graphql
NEXT_PUBLIC_SOCKET_SERVER_URL=ws://localhost:5000/socket
